# Script mode: cmake -DOUTPUT=<file.cpp> -DFILES=<name=path,...> -P EmbedFiles.cmake
# Writes a C++ source defining kEmbeddedFiles (see src/embedded_files.h).
string(REPLACE "," ";" FILES "${FILES}")

set(arrays "")
set(table "")
set(index 0)
foreach(item IN LISTS FILES)
    string(FIND "${item}" "=" eq)
    string(SUBSTRING "${item}" 0 ${eq} name)
    math(EXPR pathStart "${eq} + 1")
    string(SUBSTRING "${item}" ${pathStart} -1 path)

    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hexLength)
    math(EXPR size "${hexLength} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")

    # Trailing 0 keeps text files NUL-terminated; it isn't counted in size.
    string(APPEND arrays "static const unsigned char file${index}[] = {${bytes}0};\n")
    string(APPEND table "    {\"${name}\", file${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach()

file(WRITE "${OUTPUT}.tmp"
"// Generated by cmake/EmbedFiles.cmake. Do not edit.
#include \"embedded_files.h\"

${arrays}
const EmbeddedFile kEmbeddedFiles[] = {
${table}};
const size_t kEmbeddedFileCount = ${index};
")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
